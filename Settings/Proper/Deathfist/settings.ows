			}
		}

		General
		{
			Hero Limit: Off
		}
	}

	heroes
	{
		General
		{
			Damage Dealt: 125%

			Doomfist
			{
				Damage Dealt: 250%
				Power Block Cooldown Time: 85%
				Primary Fire: Off
				Rocket Punch Knockback Scalar: 300%
			}
		}
	}

	extensions
	{
		Buff Status Effects
	}
